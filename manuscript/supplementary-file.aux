\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces Admissibility-calibration sensitivity for the recovery objective. Recovered admissible is the calibrated-admissibility rate of the final recovered trajectory. Candidate improvement is the rate at which the optional Stage-2 admissible candidate improves the recovery objective relative to Stage 1, and helpful tradeoff additionally requires non-worse clean distance.}}{11}{table.7}\protected@file@percent }
\newlabel{tab:kappa-sens}{{S7}{11}{Admissibility-calibration sensitivity for the recovery objective. Recovered admissible is the calibrated-admissibility rate of the final recovered trajectory. Candidate improvement is the rate at which the optional Stage-2 admissible candidate improves the recovery objective relative to Stage 1, and helpful tradeoff additionally requires non-worse clean distance}{table.7}{}}
