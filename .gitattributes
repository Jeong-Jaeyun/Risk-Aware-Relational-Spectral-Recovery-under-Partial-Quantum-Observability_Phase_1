# Editable source stays portable and stable across Windows/Linux checkouts.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.bst text eol=lf
*.cls text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf

# Hash-linked scientific artifacts must preserve their original bytes.
*.json -text
biqmn/results/** -text
*.png -text
*.pdf -text
